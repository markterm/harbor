<?xml version="1.0" encoding="utf-8"?>
<!--
  Android backup: settings and saves (the firmwares' flash, small and irreplaceable) go along;
  firmware packages don't (up to 8 MB each, downloadable again, and a saved flash finds its
  package again by hash), nor the cached catalogs. Device-to-device transfer takes everything.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="packages/" />
        <exclude domain="file" path="catalog.json" />
        <exclude domain="file" path="hub-catalog.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
