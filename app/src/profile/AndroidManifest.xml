<?xml version="1.0" encoding="utf-8"?>
<!-- The profile build only: tools for filming and measuring, driven from adb. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- DUMP: only the shell (adb) holds it, so no app can drive this -->
        <receiver
            android:name=".DemoCapture"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.markwhite.harbor.demo.CAPTURE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
